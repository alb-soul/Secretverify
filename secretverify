# 33 ─ Sentry
validate_sentry() {
    local raw; raw=$(read_input "Sentry DSN (https://xxx@xxx.sentry.io/xxx) atau Auth Token")
    local keys; keys=$(parse_keys "$raw")

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        pr_head "Testing Sentry: ${key:0:50}..."
        log "=== Sentry: ${key:0:50} ==="; ((SESSION_CHECKS++))

        if [[ "$key" =~ ^https://.*@.*sentry\.io ]]; then
            # Decode DSN — jangan kirim real event (akan mencemari proyek target)
            local dsn_key dsn_host dsn_proj
            dsn_key=$(echo "$key" | grep -oP 'https://\K[^@]+')
            dsn_host=$(echo "$key" | grep -oP '@\K[^/]+')
            dsn_proj=$(echo "$key" | grep -oP '[^/]+$')
            pr_info "Sentry DSN terdeteksi — komponen:"
            pr_info "  Public Key  : ${dsn_key}"
            pr_info "  Host        : ${dsn_host}"
            pr_info "  Project ID  : ${dsn_proj}"
            pr_step "DSN = Client-Side key, dipakai SDK untuk kirim errors ke proyek"
            pr_step "Verifikasi via Sentry UI: https://sentry.io/settings/ → Project Settings → Client Keys"
            pr_step "Severity: medium-high jika publik (bisa spam/flood proyek dengan fake events)"
        else
            # Auth Token — gunakan /api/0/projects/ (butuh auth, /api/0/ tidak)
            local r; r=$(do_curl -H "Authorization: Bearer ${key}" "https://sentry.io/api/0/projects/")
            if echo "$r" | grep -qE '^\[|"id"'; then
                pr_valid "Sentry Auth Token VALID"
                local count; count=$(echo "$r" | grep -o '"slug"' | wc -l | xargs)
                [[ "$count" -gt 0 ]] && pr_info "Projects accessible: ${count}"
                log "[VALID] Sentry Auth Token"
            else
                pr_invalid "Sentry Auth Token tidak valid"
                pr_info "$(echo "$r" | grep -o '"detail":"[^"]*"' | cut -d'"' -f4)"
            fi
        fi
    done <<< "$keys"
}

