# HTTP status-code helper (2xx = valid, 401/403 = invalid)
do_curl_code() { curl -s -o /dev/null -w '%{http_code}' --max-time "$CURL_TIMEOUT" "$@"; }

# Generic live validator by HTTP status.
#   $1 title  $2 prompt  $3 url  $4 mode(bearer|token|tokenword|raw|header)
#   $5 header-name (mode=header)  $6 extra header (optional)
_v_status() {
    local title="$1" prompt="$2" url="$3" mode="$4" hname="$5" extra="$6"
    local raw; raw=$(read_input "$prompt")
    local keys; keys=$(parse_keys "$raw")
    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        pr_head "Testing ${title}: ${key:0:16}..."
        log "=== ${title}: ${key:0:16}… ==="; ((SESSION_CHECKS++))
        local -a H=()
        case "$mode" in
            bearer)    H=(-H "Authorization: Bearer ${key}") ;;
            token)     H=(-H "Authorization: token ${key}") ;;
            tokenword) H=(-H "Authorization: Token ${key}") ;;
            raw)       H=(-H "Authorization: ${key}") ;;
            header)    H=(-H "${hname}: ${key}") ;;
        esac
        [[ -n "$extra" ]] && H+=(-H "$extra")
        local code; code=$(do_curl_code "${H[@]}" "$url")
        case "$code" in
            2*)       pr_valid "${title} VALID (HTTP ${code})"; log "[VALID] ${title}" ;;
            401|403)  pr_invalid "${title} tidak valid (HTTP ${code})" ;;
            000)      pr_warn "Tidak ada koneksi / timeout — cek jaringan" ;;
            *)        pr_warn "${title}: HTTP ${code} — tidak dapat dipastikan (endpoint mungkin butuh param tambahan)" ;;
        esac
    done <<< "$keys"
}

# Generic FORMAT-ONLY validator (when no safe online check exists).
#   $1 title  $2 prompt  $3 ERE-regex  $4 manual-verify hint
_v_format() {
    local title="$1" prompt="$2" rx="$3" hint="$4"
    local raw; raw=$(read_input "$prompt")
    local keys; keys=$(parse_keys "$raw")
    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        pr_head "Format check ${title}: ${key:0:16}..."
        log "=== ${title} (format): ${key:0:16}… ==="; ((SESSION_CHECKS++))
        if [[ "$key" =~ $rx ]]; then
            pr_valid "Format ${title} sesuai pola (TIDAK diverifikasi online)"
        else
            pr_invalid "Format ${title} TIDAK cocok pola yang diharapkan"
        fi
        [[ -n "$hint" ]] && pr_info "Verifikasi manual: $hint"
    done <<< "$keys"
}

