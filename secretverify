# 46 ─ JWT Decode
validate_jwt() {
    local raw; raw=$(read_input "JWT Token (eyJ...)")
    local keys; keys=$(parse_keys "$raw")

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        pr_head "Decoding JWT: ${key:0:30}..."
        log "=== JWT: ${key:0:30}... ==="; ((SESSION_CHECKS++))

        # base64url decode helper
        b64_decode() {
            local d="$1"
            # pad
            local pad=$(( (4 - ${#d} % 4) % 4 ))
            d="${d}$(printf '=%.0s' $(seq 1 $pad))"
            echo "$d" | tr '_-' '/+' | base64 -d 2>/dev/null
        }

        local header payload
        header=$(b64_decode "$(echo "$key" | cut -d'.' -f1)")
        payload=$(b64_decode "$(echo "$key" | cut -d'.' -f2)")

        if [[ -n "$payload" ]]; then
            pr_info "─── HEADER ───"
            if command -v python3 &>/dev/null; then
                echo "$header" | python3 -m json.tool 2>/dev/null | sed 's/^/    /'
            else
                echo "    $header"
            fi
            pr_info "─── PAYLOAD ───"
            if command -v python3 &>/dev/null; then
                echo "$payload" | python3 -m json.tool 2>/dev/null | sed 's/^/    /'
            else
                echo "    $payload"
            fi

            # Expiry check
            local exp; exp=$(echo "$payload" | grep -o '"exp":[0-9]*' | cut -d':' -f2)
            if [[ -n "$exp" ]]; then
                local now; now=$(date +%s)
                if (( exp < now )); then
                    pr_warn "Token SUDAH EXPIRED (exp: $(date -d "@${exp}" 2>/dev/null || date -r "$exp" 2>/dev/null || echo "$exp"))"
                else
                    local diff=$(( exp - now ))
                    pr_valid "Token belum expired (sisa ±$((diff/3600))h$((diff%3600/60))m)"
                fi
            fi

            pr_step "Verifikasi signature: https://jwt.io — paste token untuk lihat full claims"
            log "[DECODED] JWT"
        else
            pr_invalid "Gagal decode — bukan JWT valid"
        fi
    done <<< "$keys"
}

