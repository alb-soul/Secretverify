validate_google_api() {
    local raw; raw=$(read_input "Google API Key (AIza...)")
    local keys; keys=$(parse_keys "$raw")

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        pr_head "Testing Google API Key: ${key:0:20}..."
        log "=== Google API Key: ${key:0:16}… ==="; ((SESSION_CHECKS++))

        local any_valid=false
        local r code msg

        # Helper: check JSON endpoint — field pattern passed as grep -E pattern
        _gchk_json() {
            local name="$1" url="$2" field="$3"
            r=$(do_curl "$url")
            if echo "$r" | grep -qE "$field"; then
                pr_valid "${name} → ACCESSIBLE"
                any_valid=true; log "[VALID] Google → ${name}"
            else
                msg=$(echo "$r" | grep -oE '"message" *: *"[^"]*"' | head -1 | grep -oP '(?<=: ")[^"]+')
                [[ -z "$msg" ]] && msg=$(echo "$r" | grep -oE '"status" *: *"[^"]*"' | head -1 | grep -oP '(?<=: ")[^"]+')
                pr_info "${name} → ${msg:-DENIED/not enabled}"
            fi
        }

        # Helper: check binary endpoint via HTTP code (PNG/JPEG returns)
        _gchk_bin() {
            local name="$1" url="$2"
            code=$(curl -s -o /dev/null -w "%{http_code}" --max-time "$CURL_TIMEOUT" "$url")
            if [[ "$code" == "200" ]]; then
                pr_valid "${name} → ACCESSIBLE"
                any_valid=true; log "[VALID] Google → ${name}"
            else
                pr_info "${name} → HTTP ${code}"
            fi
        }

        # Maps Geocode — Google returns "status" : "OK" (spasi di sekitar colon)
        _gchk_json "Maps Geocode" \
            "https://maps.googleapis.com/maps/api/geocode/json?latlng=40,30&key=${key}" \
            '"status" *: *"OK"'

        # Maps Static (binary PNG - check HTTP 200)
        _gchk_bin "Maps Static" \
            "https://maps.googleapis.com/maps/api/staticmap?center=45,10&zoom=7&size=400x400&key=${key}"

        # Street View (binary JPEG - check HTTP 200)
        _gchk_bin "Street View" \
            "https://maps.googleapis.com/maps/api/streetview?size=400x400&location=40.720032,-73.988354&fov=90&heading=235&pitch=10&key=${key}"

        # Places Find Place
        _gchk_json "Places Find Place" \
            "https://maps.googleapis.com/maps/api/place/findplacefromtext/json?input=Museum%20of%20Contemporary%20Art%20Australia&inputtype=textquery&fields=name&key=${key}" \
            '"status" *: *"OK"'

        # Places Autocomplete (URL-encode parentheses)
        _gchk_json "Places Autocomplete" \
            "https://maps.googleapis.com/maps/api/place/autocomplete/json?input=Bingh&types=%28cities%29&key=${key}" \
            '"status" *: *"OK"'

        # Places Text Search
        _gchk_json "Places Text Search" \
            "https://maps.googleapis.com/maps/api/place/textsearch/json?query=restaurants+in+Sydney&key=${key}" \
            '"status" *: *"OK"'

        # Places Nearby Search
        _gchk_json "Places Nearby Search" \
            "https://maps.googleapis.com/maps/api/place/nearbysearch/json?location=-33.8670522,151.1957362&radius=100&types=food&key=${key}" \
            '"status" *: *"OK"'

        # Places Details
        _gchk_json "Places Details" \
            "https://maps.googleapis.com/maps/api/place/details/json?place_id=ChIJN1t_tDeuEmsRUsoyG83frY4&fields=name,rating&key=${key}" \
            '"status" *: *"OK"'

        # YouTube Data API
        _gchk_json "YouTube Data" \
            "https://www.googleapis.com/youtube/v3/search?part=snippet&q=test&key=${key}" \
            '"items" *:'

        # Translate
        _gchk_json "Translate" \
            "https://translation.googleapis.com/language/translate/v2?q=hi&target=en&key=${key}" \
            '"translations"'

        # Gemini
        _gchk_json "Gemini" \
            "https://generativelanguage.googleapis.com/v1beta/models?key=${key}" \
            '"models" *:'

        # ── Gemini deep PoC (opt-in) — beda level dari Maps ──
        local _gem; _gem=$(do_curl "https://generativelanguage.googleapis.com/v1beta/models?key=${key}")
        if echo "$_gem" | grep -q '"models"'; then
            pr_warn "Generative Language API (Gemini) KEBUKA untuk key ini — ini beda level dari Maps"
            local _proj; _proj=$(do_curl "https://youtube.googleapis.com/youtube/v3/search?part=snippet&q=t&key=${key}" | grep -oE 'project [0-9]+' | grep -oE '[0-9]+' | head -1)
            [[ -n "$_proj" ]] && pr_info "GCP project number (bocor via error API): $_proj"
            echo ""
            echo -n -e "  ${Y}PoC Gemini: jalankan 1x generateContent (bukti LLM berbayar) + cek /files? [y/N]: ${NC}"
            read -r _ans_gem
            [[ "$_ans_gem" =~ ^[Yy]$ ]] && _google_gemini_poc "$key" "$_gem"
        fi

        $any_valid || pr_invalid "Semua endpoint ditolak — key tidak valid, terbatas, atau domain-restricted"

    done <<< "$keys"
}

