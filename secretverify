# 78 ─ Resend  (Resend-aware: bedakan full-access, sending-only, invalid, malformed)
# Read-only & NON-DESTRUKTIF. JANGAN pernah pakai POST /emails untuk validasi.
# /domains butuh full-access → dipakai untuk membedakan level akses key.
#   200                      → key VALID, full-access (severity tinggi)
#   401 restricted_api_key   → key VALID, sending-only (LIVE, bisa kirim email)
#   400 validation_error     → key malformed / bukan format Resend valid
#   401/403 lainnya          → key tidak valid / dicabut
validate_resend() {
    local raw; raw=$(read_input "Resend Key (re_...)")
    local keys; keys=$(parse_keys "$raw")

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        pr_head "Testing Resend: ${key:0:16}..."
        log "=== Resend: ${key:0:16}… ==="; ((SESSION_CHECKS++))

        local http_code body name msg
        http_code=$(curl -s -o "$SV_TMP/resend_resp" -w "%{http_code}" --max-time "$CURL_TIMEOUT" \
            -H "Authorization: Bearer ${key}" \
            "https://api.resend.com/domains")
        body=$(cat "$SV_TMP/resend_resp" 2>/dev/null)
        name=$(echo "$body" | grep -oE '"name" *: *"[^"]*"' | head -1 | cut -d'"' -f4)
        msg=$(echo "$body" | grep -oE '"message" *: *"[^"]*"' | head -1 | cut -d'"' -f4)

        if [[ "$http_code" =~ ^2 ]]; then
            pr_valid "Resend Key VALID — FULL ACCESS"
            pr_warn "⚠ Severity tinggi: full-access mail key (baca domains/api-keys, kirim email)"
            local doms; doms=$(echo "$body" | grep -oE '"name" *: *"[^"]*"' | cut -d'"' -f4 | tr '\n' ',' | sed 's/,$//')
            [[ -n "$doms" ]] && pr_info "Domains terverifikasi: ${doms}"
            log "[VALID] Resend full-access"

        elif [[ "$name" == "restricted_api_key" ]]; then
            pr_valid "Resend Key VALID — SENDING-ONLY (restricted)"
            pr_warn "⚠ Key LIVE: bisa kirim email atas nama domain terverifikasi (phishing/spoofing)"
            pr_info "Error 'restricted_api_key' = bukti key asli & aktif. TIDAK perlu kirim email untuk konfirmasi."
            pr_step "PoC aman: cukup simpan respons ini. JANGAN POST /emails (abuse kuota/reputasi domain)."
            log "[VALID] Resend sending-only (restricted)"

        elif [[ "$name" == "validation_error" ]]; then
            pr_invalid "Resend Key malformed — bukan format valid (HTTP ${http_code})"
            [[ -n "$msg" ]] && pr_info "Resend: ${msg}"
            pr_info "Cek panjang: key Resend asli ±35-51 char (re_ + 32-48). Kepanjangan = kemungkinan FP/greedy-regex."
            log "[INVALID] Resend malformed (validation_error)"

        elif [[ "$http_code" == "401" || "$http_code" == "403" ]]; then
            pr_invalid "Resend Key tidak valid / dicabut (HTTP ${http_code}${name:+ — $name})"
            log "[INVALID] Resend"

        else
            pr_warn "Resend: HTTP ${http_code} — tidak dapat dipastikan"
            [[ -n "$body" ]] && pr_info "Body: $(echo "$body" | head -c 150)"
            log "[UNKNOWN] Resend HTTP ${http_code}"
        fi
    done <<< "$keys"
}
