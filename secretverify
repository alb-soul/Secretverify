# ─────────────────────────────────────────────────────────────
# Post-validation prompt (save + kembali ke menu)
# ─────────────────────────────────────────────────────────────
after_check() {
    ask_save
    echo ""
    echo -n -e "  ${DM}[Enter untuk kembali ke menu, C untuk clear]${NC} "
    read -r back
    [[ "$back" =~ ^[Cc]$ ]] && { clear; show_banner; }
}

# ─────────────────────────────────────────────────────────────
# Main Loop
# ─────────────────────────────────────────────────────────────
main() {
    # Support argumen CLI opsional: ./secretverify <angka>  (mis. ./secretverify 17)
    clear
    show_banner

    while true; do
        echo ""
        show_menu
        read -r choice
        echo ""

        # ── Fitur search: input diawali "/" ──────────────────
        if [[ "$choice" == /* ]]; then
            search_services "${choice#/}"
            if [[ -n "$SEARCH_JUMP" ]]; then
                echo ""
                echo -n -e "  ${BLD}Langsung cek #${SEARCH_JUMP} ${SEARCH_JUMP_LABEL}? [Y/n]: ${NC}"
                read -r _cf
                if [[ "$_cf" =~ ^[Nn]$ ]]; then
                    continue
                fi
                choice="$SEARCH_JUMP"
                # jatuh ke dispatch di bawah
            else
                continue
            fi
        fi

        case "$choice" in
            [Cc]) clear; show_banner; continue ;;
            [Ss]) save_log; continue ;;
            [Qq])
                echo ""
                ask_save
                echo ""
                echo -e "  ${C}Terima kasih menggunakan secretverify — happy hunting!${NC}"
                echo ""
                exit 0 ;;
        esac

        if dispatch_choice "$choice"; then
            after_check
        else
            echo -e "  ${R}Pilihan tidak valid.${NC} Ketik ${BLD}/kata${NC} untuk cari layanan."
        fi
    done
}

# Argumen CLI opsional: ./secretverify 17  → validasi Stripe langsung sekali jalan
if [[ $# -gt 0 && "$1" =~ ^[0-9]+$ ]]; then
    show_banner
    if dispatch_choice "$1"; then
        ask_save
        exit 0
    else
        echo -e "  ${R}Nomor '$1' tidak dikenal (rentang 1-157).${NC}"
        exit 1
    fi
fi

main "$@"
