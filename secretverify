# 1 ─ AWS
validate_aws() {
    pr_head "AWS Access Key Validator"
    echo -e "  ${Y}[!]${NC} Membutuhkan Access Key ID ${BLD}dan${NC} Secret Access Key"
    echo ""
    echo -n -e "  Access Key ID (AKIA...): "
    read -r aki; aki=$(echo "$aki" | xargs)
    echo -n -e "  Secret Access Key      : "
    read -r sak; sak=$(echo "$sak" | xargs)
    [[ -z "$aki" || -z "$sak" ]] && { pr_warn "Input kosong."; return; }

    log "=== AWS: $aki ==="
    ((SESSION_CHECKS++))

    # Try AWS CLI
    if command -v aws &>/dev/null; then
        local resp
        resp=$(AWS_ACCESS_KEY_ID="$aki" AWS_SECRET_ACCESS_KEY="$sak" \
            aws sts get-caller-identity --output json 2>&1)
        if echo "$resp" | grep -q '"UserId"'; then
            pr_valid "AWS credentials VALID"
            pr_info "Account : $(echo "$resp" | grep -o '"Account":"[^"]*"' | cut -d'"' -f4)"
            pr_info "ARN     : $(echo "$resp" | grep -o '"Arn":"[^"]*"' | cut -d'"' -f4)"
            pr_warn "Cek lebih lanjut: aws s3 ls / aws iam list-users"
            return
        elif echo "$resp" | grep -qi "InvalidClientTokenId\|AuthFailure\|InvalidAccessKeyId"; then
            pr_invalid "AWS credentials tidak valid"; return
        fi
    fi

    # Fallback: Python boto3
    if command -v python3 &>/dev/null && python3 -c "import boto3" 2>/dev/null; then
        local resp
        resp=$(AWS_ACCESS_KEY_ID="$aki" AWS_SECRET_ACCESS_KEY="$sak" \
            python3 -c "import boto3,json; c=boto3.client('sts'); print(json.dumps(c.get_caller_identity()))" 2>&1)
        if echo "$resp" | grep -q "Account"; then
            pr_valid "AWS credentials VALID (via boto3)"
            pr_info "$resp"
            return
        fi
    fi

    pr_warn "AWS CLI / boto3 tidak ditemukan. Manual:"
    pr_step "pip install awscli --break-system-packages"
    pr_step "AWS_ACCESS_KEY_ID=$aki AWS_SECRET_ACCESS_KEY=<secret> aws sts get-caller-identity"
}

# 2 ─ Google API Key
# Gemini deep PoC helper (dipakai validator Google API key)
_google_gemini_poc() {
    local key="$1" modelsjson="$2"
    # Pilih model text termurah yang MASIH ADA di list (flash-lite > flash);
    # skip image/video/embedding biar murah & format request-nya cocok.
    local model
    model=$(echo "$modelsjson" | grep -oE 'models/[a-z0-9.-]+' | sed 's|models/||' \
        | grep -E 'flash-lite' | grep -vE 'image|video|veo|imagen|embedding' | head -1)
    [[ -z "$model" ]] && model=$(echo "$modelsjson" | grep -oE 'models/[a-z0-9.-]+' | sed 's|models/||' \
        | grep -E 'flash' | grep -vE 'image|video|veo|imagen|embedding' | head -1)
    [[ -z "$model" ]] && model="gemini-2.5-flash-lite"
    pr_step "Model PoC: $model (termurah yang aktif)"

    local resp
    resp=$(do_curl "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}" \
        -H 'Content-Type: application/json' \
        -d '{"contents":[{"parts":[{"text":"Reply with exactly: secretverify-poc-ok"}]}],"generationConfig":{"maxOutputTokens":10}}')
    if echo "$resp" | grep -q '"candidates"'; then
        pr_valid "Gemini generateContent BERHASIL — akses LLM BERBAYAR terbukti (severity > Maps)"
        local toks; toks=$(echo "$resp" | grep -oE '"totalTokenCount"[: ]+[0-9]+' | grep -oE '[0-9]+' | head -1)
