# Global hasil auto-jump (di-set search_services saat cocok tunggal)
SEARCH_JUMP=""
SEARCH_JUMP_LABEL=""

# ─────────────────────────────────────────────────────────────
# Search: cari layanan berdasarkan kata kunci (case-insensitive)
# Dipanggil dari menu dengan input "/kata".
# ─────────────────────────────────────────────────────────────
search_services() {
    SEARCH_JUMP=""; SEARCH_JUMP_LABEL=""
    local q; q=$(printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | tr '[:upper:]' '[:lower:]')
    if [[ -z "$q" ]]; then
        pr_warn "Kata kunci kosong. Contoh: ${BLD}/stripe${NC}  atau  ${BLD}/ai${NC}"
        return 1
    fi

    local -a hits=()
    local entry num label aliases hay tok matched
    for entry in "${SERVICES[@]}"; do
        IFS='|' read -r num label aliases <<< "$entry"
        # Tokenisasi label+alias; cocok bila ADA token yang diawali query.
        # Prefix-match > substring: /stri tetap ketemu Stripe, tapi /ai tidak
        # ikut kebawa "m(ai)l".
        hay=$(printf '%s %s' "$label" "$aliases" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' ' ')
        matched=0
        for tok in $hay; do
            [[ "$tok" == "$q"* ]] && { matched=1; break; }
        done
        (( matched )) && hits+=("${num}|${label}")
    done

    if (( ${#hits[@]} == 0 )); then
        pr_warn "Tidak ada layanan cocok dengan \"${1}\". Coba kata lain (mis. /email, /payment, /ai)."
        return 1
    fi

    pr_head "Hasil pencarian \"${1}\"  (${#hits[@]} cocok)"
    local h
    for h in "${hits[@]}"; do
        IFS='|' read -r num label <<< "$h"
        printf "  ${Y}%3s${NC}  %s\n" "$num" "$label"
    done

    if (( ${#hits[@]} == 1 )); then
        IFS='|' read -r SEARCH_JUMP SEARCH_JUMP_LABEL <<< "${hits[0]}"
    else
        echo ""
        pr_info "Ketik nomornya untuk validasi, atau /cari lagi."
    fi
    return 0
}

