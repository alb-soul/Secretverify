# ─────────────────────────────────────────────────────────────
# Key Input Reader — single key atau beberapa dipisah koma
# ─────────────────────────────────────────────────────────────
read_input() {
    local label="$1"
    # Semua echo instruksi ke stderr agar tidak ter-capture oleh $()
    echo "" >&2
    echo -e "  ${BLD}${C}► ${label}${NC}" >&2
    echo -e "  ${DM}Format: key tunggal, atau beberapa dipisah koma." >&2
    echo -e "  Baris kosong = mulai proses.${NC}" >&2
    echo "" >&2

    local collected="" line
    while IFS= read -r -p "  ❯ " line <&0; do
        [[ -z "$line" ]] && break
        collected+="$line"$'\n'
    done
    # Hanya data yang ke stdout (akan di-capture $())
    printf '%s' "$collected"
}

# ─────────────────────────────────────────────────────────────
# Key Parser
# Handles: single key, comma-separated keys
# ─────────────────────────────────────────────────────────────
parse_keys() {
    local raw="$1"
    local -a result

    # Strip CR, join all lines into one (in case of paste with newlines)
    local joined
    joined=$(printf '%s' "$raw" | tr -d '\r' | tr '\n' ',')

    IFS=',' read -ra parts <<< "$joined"
    for part in "${parts[@]}"; do
        part=$(echo "$part" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [[ -n "$part" ]] && result+=("$part")
    done

    printf '%s\n' "${result[@]}"
}

# ─────────────────────────────────────────────────────────────
# HTTP Helper
# ─────────────────────────────────────────────────────────────
do_curl() { curl -s --max-time "$CURL_TIMEOUT" "$@"; }

# ─────────────────────────────────────────────────────────────
# Save session log
# ─────────────────────────────────────────────────────────────
save_log() {
    if [[ -z "$SESSION_LOG" ]]; then
        echo -e "  ${Y}[!]${NC} Belum ada hasil untuk disimpan."
        return
    fi
    local fname="secretverify_$(date '+%Y%m%d_%H%M%S').txt"
    {
        echo "SECRETVERIFY SESSION LOG"
        echo "Generated : $(date)"
        echo "Checks    : $SESSION_CHECKS"
        printf '═%.0s' {1..52}; echo
        printf '%b' "$SESSION_LOG"
    } > "$fname"
    echo -e "  ${G}[✓]${NC} Tersimpan → ${BLD}${fname}${NC}"
}

ask_save() {
    echo ""
    echo -n -e "  ${Y}Simpan hasil ke file? [y/N]: ${NC}"
    read -r ans
    [[ "$ans" =~ ^[Yy]$ ]] && save_log
}

